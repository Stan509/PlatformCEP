{
  "name": "@cep/i18n",
  "version": "0.1.0",
  "private": true,
  "description": "Multilingue CEP — Kreyòl (défaut) / Français / English",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locales/*": "./dist/locales/*.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-locales.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cep/shared-types": "workspace:*",
    "react": "^18.3.1"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "typescript": "^5.6.2"
  }
}
