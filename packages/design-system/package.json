{
  "name": "@cep/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Design System CEP — tokens + composants (neutralité absolue, accessible, i18n)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": ["dist", "src/styles.css"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cep/i18n": "workspace:*",
    "@cep/shared-types": "workspace:*",
    "react": "^18.3.1"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "typescript": "^5.6.2"
  }
}
