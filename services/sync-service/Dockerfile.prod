# # # →  Multiple stages : `build` de tous les services  # # #
# CEP — Sync Service (production, multi-stage)
#
# Le service de synchronisation OWNS la validation de signature via le core
# Rust. Cette image construit donc le binaire `crypto-cli` (Rust) ET le worker
# Go, puis les assemble. Contexte de build = racine du monorepo.

# ---- Stage 1 : crypto-cli (Rust) ----
FROM rust:1.82-alpine AS crypto
WORKDIR /build
COPY rust/crypto-core ./rust/crypto-core
WORKDIR /build/rust/crypto-core
RUN cargo build --release --bin crypto-cli

# ---- Stage 2 : worker de synchronisation (Go) ----
FROM golang:1.22-alpine AS go-build
WORKDIR /src
COPY services/sync-service ./services/sync-service
WORKDIR /src/services/sync-service
RUN go build -o /bin/worker ./cmd/worker

# ---- Stage 3 : runtime minimal ----
FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=crypto /build/rust/crypto-core/target/release/crypto-cli /usr/local/bin/crypto-cli
COPY --from=go-build /bin/worker /bin/worker
ENV CRYPTO_CLI_BIN=/usr/local/bin/crypto-cli
EXPOSE 8090
ENTRYPOINT ["/bin/worker"]
