# CEP — Reverse-proxy & Static Web Server (Caddy)
#
# Gère le routage HTTPS/HTTP, la distribution des PWA et le reverse-proxy vers les API.

http://147.182.161.220, https://147.182.161.220, :80, :443 {
	tls internal

	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# API Django Core (Port 8000)
	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Forwarded-Proto https
		}
	}

	# Go Gateway (Port 8080)
	handle /gateway/* {
		reverse_proxy 127.0.0.1:8080
	}

	# Go/Rust Sync Service (Port 8090)
	handle /sync/* {
		reverse_proxy 127.0.0.1:8090
	}

	# Administration Portal SPA
	handle /admin* {
		root * /opt/cep/apps/cep-admin/dist
		try_files {path} {path}/ /index.html
		file_server
	}

	# Public Voter PWA SPA (Racine par défaut)
	handle {
		root * /opt/cep/apps/public-pwa/dist
		try_files {path} {path}/ /index.html
		file_server
	}
}
