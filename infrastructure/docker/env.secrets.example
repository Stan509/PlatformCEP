# CEP — environnement de production (TEMPLATE)
# ⚠️ Copiez vers `.env` à la racine / dans `infrastructure/` et remplissez.
# Aucun secret réel ne doit être committé. Ne JAMAIS placer un jeton ici.

# Postgres / base managée
POSTGRES_DB=cep
POSTGRES_USER=cep
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_HOST=CHANGE_ME                    # ex. votre hôte DigitalOcean Managed DB
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=CHANGE_ME_64_CHARS_RANDOM
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=CHANGE_ME
CSRF_TRUSTED_ORIGINS=https://CHANGE_ME
CORS_ALLOWED_ORIGINS=https://CHANGE_ME

# Passerelle Go
GATEWAY_ADDR=:8080
GATEWAY_ALLOWED_ORIGINS=https://CHANGE_ME
GATEWAY_RATE_LIMIT=600

# Synchronisation
SYNC_ADDR=:8090
DEVICE_PUBLIC_KEYS=CHANGE_ME                 # device_id:public_hex (provisionning)
